    {
      "name": "5. King - Promoters tab",
      "description": "Uses king_token. Log in as King on the web (or via your existing King OTP flow) and paste the token into the king_token variable.",
      "item": [
        {
          "name": "Invite promoter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{king_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/promoters/invites",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "promoters",
                "invites"
              ]
            },
            "description": "Invite Promoter drawer. Saves referral_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{promoter_invite_email}}\",\n  \"name\": \"Invited Promoter\",\n  \"expires_in_minutes\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json()?.data?.referral_token;",
                  "if (t) pm.collectionVariables.set(\"referral_token\", t);"
                ]
              }
            }
          ]
        },
        {
          "name": "List promoters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{king_token}}"
              }
            ],
            "url": {
