{
  "info": {
    "name": "Eventopia Web Auth - Promoter, Buyer, King Promoters CRUD",
    "description": "Only the APIs the web app calls for Promoter and Buyer auth, plus the King's Promoters tab. Tokens are saved automatically into promoter_token / buyer_token; paste king_token manually. OTPs appear in responses only when NODE_ENV=development.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000"
    },
    {
      "key": "password",
      "value": "Str0ng!Pass1"
    },
    {
      "key": "promoter_email",
      "value": "promoter@example.com"
    },
    {
      "key": "promoter_invite_email",
      "value": "invited.promoter@example.com"
    },
    {
      "key": "buyer_email",
      "value": "buyer@example.com"
    },
    {
      "key": "king_token",
      "value": ""
    },
    {
      "key": "promoter_token",
      "value": ""
    },
    {
      "key": "buyer_token",
      "value": ""
    },
    {
      "key": "challenge_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "referral_token",
      "value": ""
    },
    {
      "key": "reset_token",
      "value": ""
    },
    {
      "key": "promoter_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Promoter - invited by King (/auth/promoter/register?referral_token=...)",
      "item": [
        {
          "name": "Validate invite token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/referrals/validate/{{referral_token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "referrals",
                "validate",
                "{{referral_token}}"
              ]
            },
            "description": "PromoterInviteRegister page + 'Continue Setup' in the account-setup modal. 200 { valid, email, name } | 401 invalid | 409 used | 410 expired."
          }
        },
        {
          "name": "Accept invite (register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/promoter/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "promoter",
                "register"
              ]
            },
            "description": "Email comes from the invite. Active immediately, no approval. Saves promoter_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referral_token\": \"{{referral_token}}\",\n  \"name\": \"Invited Promoter\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"+447911123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "const t = r?.data?.accessToken || r?.data?.access_token;",
                  "if (t) { pm.collectionVariables.set(\"promoter_token\", t); console.log(\"saved promoter_token\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/promoters/invites/resend",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "promoters",
                "invites",
                "resend"
              ]
            },
            "description": "Shown when the link expired (token-expired modal / login account-setup modal).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{promoter_invite_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json()?.data?.referral_token;",
                  "if (t) pm.collectionVariables.set(\"referral_token\", t);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Promoter - self registration (/register)",
      "description": "Then the King approves it (section 5). After approval the promoter uses Login.",
      "item": [
        {
          "name": "Step 2 - Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Add \"referral_token\" only when arriving from a promoter-to-promoter referral link. Saves challenge_id / otp (otp only in development).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{promoter_email}}\",\n  \"password\": \"{{password}}\",\n  \"role_requested\": \"promoter\",\n  \"role\": \"promoter\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json()?.data || {};",
                  "if (d.challengeId) pm.collectionVariables.set(\"challenge_id\", d.challengeId);",
                  "if (d.otp) pm.collectionVariables.set(\"otp\", d.otp);",
                  "if (d.userId) pm.collectionVariables.set(\"user_id\", d.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP (VerifyIdentity page)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/otp/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "Logs the promoter in so the application can be submitted. Saves promoter_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{promoter_email}}\",\n  \"otp\": \"{{otp}}\",\n  \"challengeId\": \"{{challenge_id}}\",\n  \"userId\": \"{{user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "const t = r?.data?.accessToken || r?.data?.access_token;",
                  "if (t) { pm.collectionVariables.set(\"promoter_token\", t); console.log(\"saved promoter_token\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/otp/resend",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "otp",
                "resend"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{promoter_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json()?.data || {};",
                  "if (d.challengeId) pm.collectionVariables.set(\"challenge_id\", d.challengeId);",
                  "if (d.otp) pm.collectionVariables.set(\"otp\", d.otp);",
                  "if (d.userId) pm.collectionVariables.set(\"user_id\", d.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload avatar (optional photo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{promoter_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/files/avatar",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "files",
                "avatar"
              ]
            },
            "description": "Step 6 profile photo. Response contains the avatar URL to pass as avatar_url below.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Step 6 - Submit application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{promoter_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/promoters/applications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "promoters",
                "applications"
              ]
            },
            "description": "Phone is required (E.164). Account becomes pending_approval until the King approves.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatar_url\": null,\n  \"agreed_to_terms\": true,\n  \"agreed_to_promoter_agreement\": true,\n  \"agreed_to_activation_fee_terms\": true,\n  \"full_name\": \"Self Promoter\",\n  \"phone\": \"+447911123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
