              { "key": "Authorization", "value": "Bearer {{buyer_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"idempotency_key\": \"1234\",\n  \"items\": [\n    {\n      \"ticket_tier_id\": \"{{ticketTypeId}}\",\n      \"quantity\": 1,\n      \"attendees\": [\n        { \"name\": \"Alice\" }\n      ]\n    }\n  ]\n}"
