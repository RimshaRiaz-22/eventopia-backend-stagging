{
  "info": {
    "name": "Eventopia Event Module - Promoter, King & Buyer Web APIs",
    "description": "Only the event-module APIs actually called by the web app (Promoter portal, King's portal, and Buyer portal): event CRUD, cover/gallery images, categories, tags, ticket types, publish/cancel, King's pending-approval review/cancel-approval flow, and the Buyer's browse/search events + order/ticket-purchase flow. Login separately and paste the resulting access token into promoter_token / king_token / buyer_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000" },
    { "key": "promoter_token", "value": "" },
    { "key": "king_token", "value": "" },
    { "key": "buyer_token", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "ticketTypeId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "tagId", "value": "" },
    { "key": "galleryImageId", "value": "" },
    { "key": "shareToken", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "ticketItemId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Promoter - Events",
      "item": [
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{promoter_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Event 2\",\n  \"description\": \"Test the event 2 description\",\n  \"startAt\": \"2026-11-01T18:00:00.000Z\",\n  \"endAt\": \"2026-11-01T23:00:00.000Z\",\n  \"timezone\": \"Europe/London\",\n  \"format\": \"in_person\",\n  \"accessMode\": \"ticketed\",\n  \"visibilityMode\": \"public\",\n  \"city\": \"London\",\n  \"venueName\": \"The Grand Hall\",\n  \"venueAddress\": \"1 High Street, London\",\n  \"categoryId\": {{categoryId}},\n  \"tagIds\": [],\n  \"tagNames\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/promoters/events",
              "host": ["{{base_url}}"],
              "path": ["api", "promoters", "events"]
            }
          }
        },
        {
          "name": "List My Events (search + pagination)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{promoter_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/promoters/events?page=1&pageSize=10&search=",
              "host": ["{{base_url}}"],
              "path": ["api", "promoters", "events"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" },
                { "key": "search", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Get Event Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{promoter_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/promoters/events/{{eventId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "promoters", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{promoter_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Event 2 (updated)\",\n  \"description\": \"Updated description\",\n  \"startAt\": \"2026-11-02T18:00:00.000Z\",\n  \"endAt\": \"2026-11-02T23:00:00.000Z\",\n  \"timezone\": \"Europe/London\",\n  \"format\": \"in_person\",\n  \"accessMode\": \"ticketed\",\n  \"visibilityMode\": \"public\",\n  \"city\": \"Manchester\",\n  \"venueName\": \"The Grand Hall\",\n  \"venueAddress\": \"1 High Street, Manchester\",\n  \"categoryId\": {{categoryId}},\n  \"tagIds\": [],\n  \"tagNames\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/promoters/events/{{eventId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "promoters", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{promoter_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/promoters/events/{{eventId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "promoters", "events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Publish Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{promoter_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{base_url}}/api/promoters/events/{{eventId}}/publish",
              "host": ["{{base_url}}"],
              "path": ["api", "promoters", "events", "{{eventId}}", "publish"]
            }
          }
        },
        {
          "name": "Cancel Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{promoter_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{base_url}}/api/promoters/events/{{eventId}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "promoters", "events", "{{eventId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
